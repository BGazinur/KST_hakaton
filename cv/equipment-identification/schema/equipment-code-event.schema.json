{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pump-cv:equipment-code-event:1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "event", "requestId", "equipmentCode", "source", "sessionId", "inspectionEpoch", "frameTimestampNs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "event": {"const": "equipment_code_recognized"},
    "requestId": {"type": "string", "minLength": 1},
    "equipmentCode": {"type": "string", "pattern": "^[0-9]{8}$", "minLength": 8, "maxLength": 8},
    "source": {"enum": ["QR", "OCR"]},
    "sessionId": {"type": "string", "minLength": 1},
    "inspectionEpoch": {"type": "string", "pattern": "^[0-9]+$"},
    "frameTimestampNs": {"type": "string", "pattern": "^[0-9]+$"}
  }
}
